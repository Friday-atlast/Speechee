{
  "_comment": "Speechee Default Configuration - DO NOT EDIT",
  "_version": "1.0.0",
  
  "app": {
    "name": "Speechee",
    "version": "1.0.0-dev",
    "mode": "offline",
    "debug": false
  },
  
  "stt": {
    "model": "tiny",
    "language": "auto",
    "threads": 2,
    "translate": false
  },
  
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "format": "wav",
    "default_duration": 5,
    "max_duration": 300,
    "device_id": null
  },
  
  "output": {
    "format": "txt",
    "save_audio": false,
    "auto_save": false,
    "include_timestamps": true,
    "transcripts_dir": "output/transcripts",
    "temp_dir": "output/temp"
  },
  
  "models": {
    "default": "tiny",
    "default_multilingual": "tiny",
    "auto_download": false,
    "models_dir": "engine/models"
  },
  
  "api": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8000,
    "cors_origins": ["*"]
  },
  
  "cli": {
    "show_banner": true,
    "colored_output": true,
    "verbose": false
  },
  
  "performance": {
    "max_threads": 2,
    "low_memory_mode": true,
    "target_ram_mb": 800
  }
}